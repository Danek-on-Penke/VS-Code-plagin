{
  "name": "code-recovery",
  "displayName": "Code Recovery",
  "description": "Restore deleted code character by character using the last git commit. Each keypress recovers the next deleted character.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "recovery",
    "restore",
    "undo"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeRecovery.start",
        "title": "Start Code Recovery",
        "category": "Code Recovery"
      },
      {
        "command": "codeRecovery.stop",
        "title": "Stop Code Recovery",
        "category": "Code Recovery"
      },
      {
        "command": "codeRecovery.toggle",
        "title": "Toggle Code Recovery Mode",
        "category": "Code Recovery"
      }
    ],
    "keybindings": [
      {
        "command": "codeRecovery.toggle",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeRecovery.toggle",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node out/test/computeDeletedChars.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
